<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PackageId>Coderz.MoonSharp.Plus</PackageId>
        <Title>Coderz.MoonSharp.Plus</Title>
        <Description>A fork of MoonSharp, the C# Lua interpreter by Marco Mastropaolo, for embedding untrusted or money-handling scripts. Adds host-set execution limits (instruction budget and CancellationToken) that terminate runaway scripts with an exception script code cannot intercept, plus exact 'integer' (Int64) and 'decimal' (System.Decimal) numeric types with checked arithmetic.</Description>
        <PackageTags>lua;interpreter;scripting;sandbox;embedding;decimal;moonsharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>keypair.snk</AssemblyOriginatorKeyFile>
        <DefineConstants>$(DefineConstants);DOTNET_CORE;HASDYNAMIC</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <None Include="NUGET.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

</Project>
